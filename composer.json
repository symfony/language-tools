{
    "name": "symfony/lsp",
    "description": "A language server for Symfony applications",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "amphp/amp": "^3.1",
        "amphp/byte-stream": "^2.1",
        "fabpot/json-rpc-peer": "^0.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "symfony/phpunit-bridge": "^7.4|^8.0",
        "php-cs-fixer/shim": "^3.87"
    },
    "autoload": {
        "psr-4": {
            "Symfony\\Lsp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Symfony\\Lsp\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/symfony-lsp"
    ],
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit --no-progress",
        "phpstan": "phpstan analyze --no-progress",
        "cs-fix": "php-cs-fixer fix --show-progress=none"
    }
}
