#!/usr/bin/env php
<?php

require \dirname(__DIR__).'/vendor/autoload.php';
require __DIR__.'/InteractiveProcessRunner.php';
require __DIR__.'/ReleaseProcessRunner.php';
require __DIR__.'/ReleaseGit.php';
require __DIR__.'/ReleaseGitHub.php';
require __DIR__.'/ReleaseSleeperInterface.php';
require __DIR__.'/NativeReleaseSleeper.php';
require __DIR__.'/ReleaseMetadataUpdater.php';
require __DIR__.'/ReleaseVersion.php';
require __DIR__.'/ReleaseCommand.php';

use Symfony\Lsp\Tools\InteractiveProcessRunner;
use Symfony\Lsp\Tools\NativeReleaseSleeper;
use Symfony\Lsp\Tools\ReleaseCommand;
use Symfony\Lsp\Tools\ReleaseGit;
use Symfony\Lsp\Tools\ReleaseGitHub;
use Symfony\Lsp\Tools\ReleaseMetadataUpdater;
use Symfony\Lsp\Tools\ReleaseProcessRunner;

/** @var list<string> $argv */
$arguments = array_slice($argv, 1);
$confirmed = false;
$version = null;
foreach ($arguments as $argument) {
    if ('--yes' === $argument) {
        $confirmed = true;
        continue;
    }
    if (null !== $version) {
        fwrite(\STDERR, "Usage: tools/release X.Y.Z[-PRERELEASE] [--yes]\n");
        exit(2);
    }
    $version = $argument;
}
if (null === $version) {
    fwrite(\STDERR, "Usage: tools/release X.Y.Z[-PRERELEASE] [--yes]\n");
    exit(2);
}

if (!$confirmed) {
    fwrite(\STDOUT, sprintf(
        "This will prepare %s, push main, wait for CI, publish v%s and start the next development cycle.\nType %s to continue: ",
        $version,
        $version,
        $version,
    ));
    $answer = fgets(\STDIN);
    if (false === $answer || $version !== trim($answer)) {
        fwrite(\STDERR, "Release canceled.\n");
        exit(1);
    }
}

try {
    $root = dirname(__DIR__);
    $processes = new ReleaseProcessRunner(new InteractiveProcessRunner());
    $command = new ReleaseCommand(
        $root,
        new ReleaseMetadataUpdater(),
        $processes,
        new ReleaseGit($root, $processes),
        new ReleaseGitHub($root, $processes),
        new NativeReleaseSleeper(),
    );
    $command->release($version);
} catch (Throwable $error) {
    fwrite(\STDERR, $error->getMessage()."\n");
    exit(1);
}
