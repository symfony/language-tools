#!/usr/bin/env php
<?php

require __DIR__.'/../vendor/autoload.php';
require_once __DIR__.'/ContentLengthProcessClient.php';

use Symfony\Lsp\Tools\ContentLengthProcessClient;

$deadlineSeconds = (float) (getenv('SYMFONY_LSP_SMOKE_DEADLINE') ?: 60);
define('READ_DEADLINE_SECONDS', $deadlineSeconds);
define('SMOKE_TEST_START', microtime(true));
define('CHECK_DIAGNOSTICS_EXIT', 10);
define('INVOCATION_EXIT', 11);

function progress(string $message): void
{
    fwrite(\STDOUT, sprintf('[%6.2fs] %s', microtime(true) - SMOKE_TEST_START, $message)."\n");
    fflush(\STDOUT);
}

/**
 * @param list<string> $command
 *
 * @return array{exitCode: int, stdout: string, stderr: string}
 */
function executeServerCommand(array $command): array
{
    $outputPath = tempnam(sys_get_temp_dir(), 'lsp-command-out-');
    $errorPath = tempnam(sys_get_temp_dir(), 'lsp-command-err-');
    if (false === $outputPath || false === $errorPath) {
        throw new RuntimeException('Unable to create the command smoke test output files.');
    }

    try {
        $process = proc_open(
            $command,
            [
                ['file', 'Windows' === \PHP_OS_FAMILY ? 'NUL' : '/dev/null', 'r'],
                ['file', $outputPath, 'w'],
                ['file', $errorPath, 'w'],
            ],
            $pipes,
            options: ['bypass_shell' => true],
        );
        if (!is_resource($process)) {
            throw new RuntimeException('Unable to start the command smoke test.');
        }

        return [
            'exitCode' => proc_close($process),
            'stdout' => (string) file_get_contents($outputPath),
            'stderr' => (string) file_get_contents($errorPath),
        ];
    } finally {
        @unlink($outputPath);
        @unlink($errorPath);
    }
}

function checkCommandDispatch(string $server, ?string $expectedVersion): void
{
    progress('Checking executable command dispatch');
    $version = executeServerCommand([$server, '--version']);
    $expectedOutput = null === $expectedVersion ? null : 'Symfony Language Tools '.$expectedVersion."\n";
    if (0 !== $version['exitCode']
        || '' !== $version['stderr']
        || (null !== $expectedOutput && $expectedOutput !== $version['stdout'])
        || (null === $expectedOutput && 1 !== preg_match('/^Symfony Language Tools (?:dev|\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?)\n$/D', $version['stdout']))
    ) {
        throw new RuntimeException('The executable returned an unexpected version contract.');
    }

    $unknown = executeServerCommand([$server, 'unknown-command']);
    if (INVOCATION_EXIT !== $unknown['exitCode']
        || '' !== $unknown['stdout']
        || 'Unknown command "unknown-command".'.\PHP_EOL !== $unknown['stderr']
    ) {
        throw new RuntimeException('The executable accepted an unknown top-level command.');
    }
    progress('Executable command dispatch passed');
}

function checkSavedDiagnostics(string $server, ?string $expectedVersion): void
{
    $directory = sys_get_temp_dir().'/symfony-lsp-smoke-'.bin2hex(random_bytes(6));
    mkdir($directory.'/config', 0777, true);
    file_put_contents($directory.'/composer.json', '{"type":"project","require":{"symfony/framework-bundle":"^8.0"}}');
    file_put_contents($directory.'/config/services.yaml', "parameters:\n    broken: '%env(APP_SECRET%'\n");

    try {
        progress('Starting the headless diagnostics check');
        $execution = executeServerCommand([$server, 'check', '--source-only', '--format=json', '--workspace='.$directory]);
        if (CHECK_DIAGNOSTICS_EXIT !== $execution['exitCode']) {
            throw new RuntimeException('The headless diagnostics check exited with status '.$execution['exitCode'].":\n".$execution['stderr']);
        }
        $report = json_decode($execution['stdout'], true, flags: \JSON_THROW_ON_ERROR);
        if (!is_array($report)
            || true !== ($report['complete'] ?? null)
            || 'env.malformed_chain' !== ($report['diagnostics'][0]['code'] ?? null)
        ) {
            throw new RuntimeException('The headless diagnostics check returned an unexpected report.');
        }
        if (null !== $expectedVersion && $expectedVersion !== ($report['tool']['version'] ?? null)) {
            throw new RuntimeException('The headless diagnostics check reported an unexpected version.');
        }
        progress('Headless diagnostics check passed');
    } finally {
        removeTree($directory);
    }
}

function removeTree(string $path): void
{
    if (!is_dir($path)) {
        @unlink($path);

        return;
    }
    foreach (scandir($path) ?: [] as $entry) {
        if ('.' !== $entry && '..' !== $entry) {
            removeTree($path.'/'.$entry);
        }
    }
    @rmdir($path);
}

$arguments = array_slice($argv, 1);
$socketMode = '--socket' === ($arguments[0] ?? null);
if ($socketMode) {
    array_shift($arguments);
}
if (!isset($arguments[0])) {
    fwrite(\STDERR, "Usage: smoke-test-server [--socket] <server> [expected-version]\n");
    exit(2);
}

checkCommandDispatch($arguments[0], $arguments[1] ?? null);

progress('Starting Symfony Language Tools');
$connection = new ContentLengthProcessClient([$arguments[0]], READ_DEADLINE_SECONDS, socketMode: $socketMode);
try {
    progress('Initializing');
    $initialize = $connection->request(1, 'initialize', [
        'processId' => null,
        'rootUri' => null,
        'capabilities' => new stdClass(),
        'initializationOptions' => ['workspaceTrust' => false],
    ]);
    $connection->notify('initialized');
    progress('Shutting down');
    $shutdown = $connection->request(2, 'shutdown');
    $connection->notify('exit');
    progress('Closing');
    $exitCode = $connection->close();
    if (0 !== $exitCode) {
        throw new RuntimeException('Symfony Language Tools exited with status '.$exitCode.":\n".$connection->errorOutput());
    }
    progress('Closed');
} finally {
    $connection->terminate();
}
if (1 !== ($initialize['id'] ?? null) || !isset($initialize['result']['capabilities'])) {
    throw new RuntimeException('Symfony Language Tools did not initialize successfully.');
}
if (isset($arguments[1]) && $arguments[1] !== ($initialize['result']['serverInfo']['version'] ?? null)) {
    throw new RuntimeException('Symfony Language Tools reported an unexpected protocol version.');
}
if (2 !== ($shutdown['id'] ?? null) || !array_key_exists('result', $shutdown)) {
    throw new RuntimeException('Symfony Language Tools did not shut down successfully.');
}

checkSavedDiagnostics($arguments[0], $arguments[1] ?? null);
fwrite(\STDOUT, "Symfony Language Tools smoke test passed.\n");
