    exit 1
fi
route_line=${route_match%%:*}
route_source=${route_match#*:}
route_prefix=${route_source%%$route_name*}
route_close_column=$((${#route_prefix} + ${#route_name} + 1))
route_hover_column=$((route_close_column - 5))
ready_line=${ready_match%%:*}
ready_source=${ready_match#*:}
ready_prefix=${ready_source%%admin_index*}
ready_column=$((${#ready_prefix} + 5))

"$code_command" \
    --user-data-dir "$demo_profile" \
    --extensions-dir "$demo_extensions" \
    --install-extension "$extension" \
    --install-extension "$twig_extension" \
    --force

demo_port=$(available_port)
while [[ "$demo_port" == "$install_port" ]]; do
    demo_port=$(available_port)
done
ports+=("$demo_port")
"$code_command" \
    --user-data-dir "$demo_profile" \
    --extensions-dir "$demo_extensions" \
    --remote-debugging-port="$demo_port" \
    --new-window \
    "$demo" \
    -g "$controller:$ready_line:$ready_column" \
    >"$state/demo-vscode.log" 2>&1 &
launchers+=("$!")
wait_for_cdp "$demo_port"
node "$cdp" "$demo_port" wait 'document.title.includes("symfony-demo")' 45
node "$cdp" "$demo_port" evaluate "$clean_ui" >/dev/null
sleep 2
node "$cdp" "$demo_port" evaluate "$clean_ui" >/dev/null
node "$cdp" "$demo_port" wait 'Array.from(document.querySelectorAll(".statusbar-item")).some((element) => element.getAttribute("aria-label")?.includes("source ready, runtime ready"))' 120
node "$cdp" "$demo_port" evaluate "$clean_ui" >/dev/null
node "$cdp" "$demo_port" mouse 1320 780
node "$cdp" "$demo_port" wait '0 === document.querySelectorAll(".monaco-hover:not(.hidden)").length' 5
node "$cdp" "$demo_port" screenshot "$raw/project-ready.png"

case "$(uname -s)" in
    Darwin)
        primary_modifier=4
        palette_modifiers=12
        ;;
    *)
        primary_modifier=2
        palette_modifiers=10
        ;;
esac

location_after() {
    php -r '$text = file_get_contents($argv[1]); $offset = strpos($text, $argv[2]); if (false === $offset) { fwrite(STDERR, "Needle not found: ".$argv[2]."\n"); exit(1); } $offset += strlen($argv[2]); $before = substr($text, 0, $offset); $line = substr_count($before, "\n") + 1; $last = strrpos($before, "\n"); $column = strlen(false === $last ? $before : substr($before, $last + 1)) + 1; echo $line.":".$column;' "$1" "$2"
}

location_inside() {
    php -r '$text = file_get_contents($argv[1]); $lineOffset = strpos($text, $argv[2]); $symbolOffset = strpos($argv[2], $argv[3]); if (false === $lineOffset || false === $symbolOffset) { fwrite(STDERR, "Symbol not found: ".$argv[3]."\n"); exit(1); } $offset = $lineOffset + $symbolOffset + intdiv(strlen($argv[3]), 2); $before = substr($text, 0, $offset); $line = substr_count($before, "\n") + 1; $last = strrpos($before, "\n"); $column = strlen(false === $last ? $before : substr($before, $last + 1)) + 1; echo $line.":".$column;' "$1" "$2" "$3"
}

json_string() {
    node -e 'process.stdout.write(JSON.stringify(process.argv[1]))' "$1"
}

replace_once() {
    php -r '$path = $argv[1]; $contents = file_get_contents($path); $contents = str_replace($argv[2], $argv[3], $contents, $count); if (1 !== $count) { fwrite(STDERR, "Expected one replacement in ".$path.", found ".$count.".\n"); exit(1); } file_put_contents($path, $contents);' "$1" "$2" "$3"
}

open_command_palette() {
    node "$cdp" "$1" key "$palette_modifiers" P KeyP 80
    node "$cdp" "$1" wait '(() => { const widget = document.querySelector(".quick-input-widget"); return widget && "none" !== getComputedStyle(widget).display && null !== widget.offsetParent; })()' 10
}

move_pointer() {
    node "$cdp" "$1" mouse 1320 780
    node "$cdp" "$1" wait '0 === document.querySelectorAll(".monaco-hover:not(.hidden)").length' 5
}

dismiss_notifications() {
    node "$cdp" "$1" evaluate 'document.querySelectorAll("a[aria-label^=\"Clear Notification\"]").forEach((element) => element.click()); true' >/dev/null
    node "$cdp" "$1" wait '0 === document.querySelectorAll(".notifications-toasts .notification-list-item").length' 5
}

focus_completion() {
    local port="$1" expected_json detail_json target focused steps key code virtual_key step selected
    expected_json=$(json_string "$2")
    detail_json=$(json_string "${3:-}")
    target=$(node "$cdp" "$port" evaluate "(() => { const rows = Array.from(document.querySelectorAll('.suggest-widget.visible .monaco-list-row')); const matches = rows.flatMap((row, index) => row.querySelector('.label-name')?.textContent.trim() === $expected_json ? [index] : []); return '' === $detail_json ? (matches[0] ?? -1) : (matches.at(-1) ?? -1); })()")
    focused=$(node "$cdp" "$port" evaluate "Array.from(document.querySelectorAll('.suggest-widget.visible .monaco-list-row')).findIndex((row) => row.classList.contains('focused'))")
    if ((target < 0 || focused < 0)); then
        echo "Unable to find the expected completion row: $2" >&2
        return 1
    fi
    if ((target < focused)); then
        steps=$((focused - target))
        key=ArrowUp
        code=ArrowUp
        virtual_key=38
    else
        steps=$((target - focused))
        key=ArrowDown
        code=ArrowDown
        virtual_key=40
    fi
    for ((step = 0; step < steps; step++)); do
        node "$cdp" "$port" key 0 "$key" "$code" "$virtual_key"
    done
    selected=$(node "$cdp" "$port" evaluate "(() => { const row = document.querySelector('.suggest-widget.visible .monaco-list-row.focused'); return row?.querySelector('.label-name')?.textContent.trim() === $expected_json && ('' === $detail_json || row.textContent.includes($detail_json)); })()")
    if [[ "$selected" != true ]]; then
        echo "Unable to select the expected completion row: $2" >&2
        return 1
    fi
}

refresh_index() {
    open_command_palette "$1"
    node "$cdp" "$1" text 'Symfony LSP: Refresh Index'
    sleep 1
    node "$cdp" "$1" key 0 Enter Enter 13
    sleep 2
    node "$cdp" "$1" wait 'Array.from(document.querySelectorAll(".statusbar-item")).some((element) => element.getAttribute("aria-label")?.includes("source ready, runtime ready"))' 120
}

close_active_editor() {
    local port="$1" dirty attempt
    for attempt in 1 2 3 4 5; do
        dirty=$(node "$cdp" "$port" evaluate 'document.querySelector(".tab.active")?.classList.contains("dirty") ?? false')
        [[ "$dirty" != true ]] && break
        node "$cdp" "$port" key "$primary_modifier" Z KeyZ 90
        sleep 1
    done
    dirty=$(node "$cdp" "$port" evaluate 'document.querySelector(".tab.active")?.classList.contains("dirty") ?? false')
    if [[ "$dirty" == true ]]; then
        echo 'Refusing to close an editor with unsaved changes.' >&2
        return 1
    fi
    node "$cdp" "$port" evaluate 'document.querySelector(".tab.active a[aria-label^=Close]")?.click(); true' >/dev/null
    sleep 1
}

show_completion() {
    local port="$1" expression="$2" attempt
    for attempt in 1 2 3; do
        if [[ "$(node "$cdp" "$port" evaluate "$expression")" == true ]]; then
            return
        fi
        node "$cdp" "$port" key 2 ' ' Space 32
        if node "$cdp" "$port" wait "$expression" 10; then
            return
        fi
        node "$cdp" "$port" key 0 Escape Escape 27
        sleep 2
    done
    echo 'Unable to open the expected completion list.' >&2
    return 1
}

show_hover() {
    local port="$1" expression="$2" attempt
    for attempt in 1 2 3; do
        open_command_palette "$port"
        node "$cdp" "$port" text 'Show or Focus Hover'
        sleep 1
        node "$cdp" "$port" key 0 Enter Enter 13
        if node "$cdp" "$port" wait "$expression" 10; then
            return
        fi
        node "$cdp" "$port" key 0 Escape Escape 27
        sleep 2
    done
    echo 'Unable to open the expected hover.' >&2
    return 1
}

show_environment_picker() {
    local port="$1" expression="$2" attempt
    for attempt in 1 2 3; do
        open_command_palette "$port"
        node "$cdp" "$port" text 'Symfony LSP: Switch Environment'
        sleep 1
        node "$cdp" "$port" key 0 Enter Enter 13
        if node "$cdp" "$port" wait "$expression" 10; then
            return
        fi
        node "$cdp" "$port" key 0 Escape Escape 27
        sleep 2
    done
    echo 'Unable to open the environment picker.' >&2
    return 1
}

capture_completion() {
    local port="$1" profile="$2" extensions="$3" name="$4" file="$5" needle="$6" expected="$7" expected_detail="${8:-}"
    local location expected_json
    location=$(location_after "$file" "$needle")
    expected_json=$(json_string "$expected")
    open_location "$profile" "$extensions" "$file:$location"
    sleep 2
    move_pointer "$port"
    local completion_expression="Array.from(document.querySelectorAll('.suggest-widget.visible .monaco-list-row')).some((element) => element.textContent.includes($expected_json))"
    show_completion "$port" "$completion_expression"
    focus_completion "$port" "$expected" "$expected_detail"
    dismiss_notifications "$port"
    node "$cdp" "$port" screenshot "$raw/$name.png"
    node "$cdp" "$port" key 0 Escape Escape 27
    close_active_editor "$port"
}

capture_hover() {
    local port="$1" profile="$2" extensions="$3" name="$4" file="$5" line_needle="$6" symbol="$7" expected="$8"
    local location expected_json
    location=$(location_inside "$file" "$line_needle" "$symbol")
    expected_json=$(json_string "$expected")
    open_location "$profile" "$extensions" "$file:$location"
    sleep 1
    move_pointer "$port"
    show_hover "$port" "Array.from(document.querySelectorAll('.monaco-hover:not(.hidden)')).some((element) => element.textContent.includes($expected_json))"
    dismiss_notifications "$port"
    node "$cdp" "$port" screenshot "$raw/$name.png"
    node "$cdp" "$port" key 0 Escape Escape 27
    close_active_editor "$port"
}

