#!/usr/bin/env bash
set -euo pipefail

require_token() {
    if [[ -z "${OVSX_PAT:-}" ]]; then
        echo "OVSX_PAT is required to publish to Open VSX." >&2
        exit 2
    fi
}

if [[ "${1:-}" = --verify ]]; then
    if [[ $# -ne 2 ]]; then
        echo "Usage: publish-open-vsx --verify NAMESPACE" >&2
        exit 2
    fi
    require_token
    npx ovsx verify-pat "$2"
    exit
fi
if [[ $# -ne 1 ]]; then
    echo "Usage: publish-open-vsx VSIX_DIRECTORY" >&2
    exit 2
fi
require_token

vsix_directory="$1"
attempts="${OVSX_PUBLISH_ATTEMPTS:-3}"
retry_delay="${OVSX_PUBLISH_RETRY_DELAY:-15}"
if [[ ! "$attempts" =~ ^[1-9][0-9]*$ || ! "$retry_delay" =~ ^[0-9]+$ ]]; then
    echo "Publish attempts must be positive and retry delay must be non-negative." >&2
    exit 2
fi
options=(publish --skip-duplicate)

shopt -s nullglob
packages=("$vsix_directory"/*.vsix)
if [[ ${#packages[@]} -eq 0 ]]; then
    echo "No VSIX packages found in $vsix_directory." >&2
    exit 1
fi

for package in "${packages[@]}"; do
    published=false
    for ((attempt = 1; attempt <= attempts; ++attempt)); do
        if npx ovsx "${options[@]}" "$package"; then
            published=true
            break
        fi
        if ((attempt < attempts)); then
            echo "Publishing $(basename "$package") failed on attempt $attempt; retrying." >&2
            sleep "$retry_delay"
        fi
    done
    if [[ "$published" != true ]]; then
        echo "Unable to publish $(basename "$package") after $attempts attempts." >&2
        exit 1
    fi
done
