#!/usr/bin/env php
<?php

require __DIR__.'/../vendor/autoload.php';
require_once __DIR__.'/ContentLengthProcessClient.php';

use Symfony\Lsp\Tools\ContentLengthProcessClient;
use Symfony\Lsp\Tools\Dogfood\ConfigurationException;
use Symfony\Lsp\Tools\Dogfood\ProtocolValidator;
use Symfony\Lsp\Tools\Dogfood\ResponseAssertions;
use Symfony\Lsp\Tools\Dogfood\ResponseFingerprint;
use Symfony\Lsp\Tools\Dogfood\ScenarioLocator;
use Symfony\Lsp\Tools\Dogfood\ScenarioManifestLoader;
use Symfony\Lsp\Tools\Dogfood\ScenarioRunner;
use Symfony\Lsp\Tools\Dogfood\ServerHarness;
use Symfony\Lsp\Tools\Dogfood\Utf16Positions;
use Symfony\Lsp\Tools\Dogfood\WorkspaceEditApplier;

const USAGE = "Usage: dogfood-server --scenarios=FILE [--revision=COMMIT] [--environment=ENV] [--index-timeout=SECONDS] [--request-timeout=SECONDS] <server> <project>\n";

$environment = 'dev';
$indexTimeout = 30.0;
$requestTimeout = 10.0;
$scenarioPath = null;
$revision = null;
$positional = [];
foreach (array_slice($argv, 1) as $argument) {
    if (preg_match('/^--environment=(.+)$/', $argument, $matches)) {
        $environment = $matches[1];
    } elseif (preg_match('/^--index-timeout=(\d+)$/', $argument, $matches)) {
        $indexTimeout = (float) $matches[1];
    } elseif (preg_match('/^--request-timeout=(\d+)$/', $argument, $matches)) {
        $requestTimeout = (float) $matches[1];
    } elseif (preg_match('/^--scenarios=(.+)$/', $argument, $matches)) {
        $scenarioPath = $matches[1];
    } elseif (preg_match('/^--revision=(.+)$/', $argument, $matches)) {
        $revision = $matches[1];
    } elseif (str_starts_with($argument, '-')) {
        fwrite(\STDERR, USAGE);
        exit(2);
    } else {
        $positional[] = $argument;
    }
}
if (2 !== count($positional) || null === $scenarioPath) {
    fwrite(\STDERR, USAGE);
    exit(2);
}
[$server, $project] = $positional;
$project = realpath($project);
if (false === $project) {
    fwrite(\STDERR, "The project does not exist.\n");
    exit(2);
}

try {
    $manifest = (new ScenarioManifestLoader())->load($scenarioPath, $revision);
} catch (ConfigurationException $exception) {
    fwrite(\STDERR, $exception->getMessage()."\n");
    exit(2);
}

function uri(string $path): string
{
    return 'file://'.str_replace('%2F', '/', rawurlencode($path));
}

$totalStartedAt = hrtime(true);
$elapsedMilliseconds = static fn (int $startedAt): float => round((hrtime(true) - $startedAt) / 1_000_000, 1);
$timings = [
    'startupMilliseconds' => null,
    'initializeMilliseconds' => null,
    'sourceIndexMilliseconds' => null,
    'runtimeIndexMilliseconds' => null,
    'indexWaitMilliseconds' => null,
    'scenariosMilliseconds' => null,
    'shutdownMilliseconds' => null,
    'totalMilliseconds' => null,
];
$report = [
    'project' => $project,
    'environment' => $environment,
    'manifestRevision' => $manifest->revision,
    'serverVersion' => null,
    'status' => null,
    'terminal' => false,
    'outcome' => 'aborted',
    'error' => null,
    'scenarioCount' => count($manifest->scenarios),
    'scenarios' => [],
    'requestCount' => 0,
    'assertionFailures' => 0,
    'violations' => [],
    'transportFailure' => null,
    'serverError' => null,
    'exitCode' => null,
    'runtimeBridgeTimings' => null,
    'timings' => $timings,
];

$client = null;
try {
    $startupStartedAt = hrtime(true);
    $client = new ContentLengthProcessClient([$server], max(10.0, $requestTimeout), getenv());
    $timings['startupMilliseconds'] = $elapsedMilliseconds($startupStartedAt);

    $id = 1;
    $initializeStartedAt = hrtime(true);
    $initialize = $client->request($id, 'initialize', [
        'processId' => null,
        'rootUri' => uri($project),
        'workspaceFolders' => [['uri' => uri($project), 'name' => basename($project)]],
        'capabilities' => new stdClass(),
        'initializationOptions' => ['workspaceTrust' => true, 'runtimeIndexing' => true, 'environment' => $environment],
    ], 10.0);
    $timings['initializeMilliseconds'] = $elapsedMilliseconds($initializeStartedAt);
    $report['serverVersion'] = $initialize['result']['serverInfo']['version'] ?? null;
    $client->notify('initialized');

    $indexStartedAt = hrtime(true);
    $deadline = microtime(true) + $indexTimeout;
    while (microtime(true) < $deadline) {
        $response = $client->request(++$id, 'workspace/executeCommand', ['command' => 'symfony.indexStatus'], $requestTimeout);
        $status = $response['result'][0] ?? null;
        if (is_array($status)) {
            $report['status'] = $status;
            if (null === $timings['sourceIndexMilliseconds'] && in_array($status['source']['state'] ?? null, ['ready', 'failed'], true)) {
                $timings['sourceIndexMilliseconds'] = $elapsedMilliseconds($indexStartedAt);
            }
            if (null === $timings['runtimeIndexMilliseconds'] && in_array($status['runtime']['state'] ?? null, ['ready', 'partial', 'failed', 'stale'], true)) {
                $timings['runtimeIndexMilliseconds'] = $elapsedMilliseconds($indexStartedAt);
            }
            if (null !== $timings['sourceIndexMilliseconds'] && null !== $timings['runtimeIndexMilliseconds']) {
                $report['terminal'] = true;
                break;
            }
        }
        usleep(250_000);
    }
    $timings['indexWaitMilliseconds'] = $elapsedMilliseconds($indexStartedAt);
    $report['runtimeBridgeTimings'] = is_array($report['status']['runtime']['timings'] ?? null) ? $report['status']['runtime']['timings'] : null;

    $runner = new ScenarioRunner(
        $client,
        new ScenarioLocator(),
        new ResponseAssertions(),
        new ProtocolValidator(),
        new WorkspaceEditApplier(new Utf16Positions()),
        new ResponseFingerprint(),
        $requestTimeout,
    );
    $scenariosStartedAt = hrtime(true);
    $ready = 'ready' === ($report['status']['source']['state'] ?? null) && 'ready' === ($report['status']['runtime']['state'] ?? null);
    $report = array_replace($report, $ready
        ? $runner->run($manifest, $project)
        : ScenarioRunner::unavailable($manifest, 'Source and runtime indexing must be ready before scenarios run.'));
    $timings['scenariosMilliseconds'] = $elapsedMilliseconds($scenariosStartedAt);

    $shutdownStartedAt = hrtime(true);
    if (null === $report['transportFailure']) {
        $client->request(++$id, 'shutdown', timeout: $requestTimeout);
        $client->notify('exit');
        $report['exitCode'] = $client->close(ServerHarness::PROCESS_EXIT_TIMEOUT);
    } else {
        $report['exitCode'] = $client->terminate();
    }
    $timings['shutdownMilliseconds'] = $elapsedMilliseconds($shutdownStartedAt);
    $stderr = trim($client->errorOutput());
    $report['serverError'] = '' === $stderr ? null : $stderr;
    $report['outcome'] = outcome($report);
} catch (Throwable $exception) {
    $report['error'] = $exception->getMessage();
    $report['outcome'] = 'aborted';
    if ([] === $report['scenarios']) {
        $report = array_replace($report, ScenarioRunner::unavailable($manifest, $exception->getMessage()));
    }
    if (null !== $client) {
        $report['exitCode'] = $client->terminate();
        $stderr = trim($client->errorOutput());
        $report['serverError'] = '' === $stderr ? null : $stderr;
    }
    $timings['totalMilliseconds'] = $elapsedMilliseconds($totalStartedAt);
    $report['timings'] = $timings;
    write($report);

    exit(1);
} finally {
    $client?->terminate();
}

$timings['totalMilliseconds'] = $elapsedMilliseconds($totalStartedAt);
$report['timings'] = $timings;
write($report);

/**
 * @param array<string, mixed> $report
 */
function outcome(array $report): string
{
    if (null !== $report['transportFailure']) {
        return 'aborted';
    }
    if (0 !== $report['assertionFailures'] || [] !== $report['violations'] || [] === $report['scenarios']) {
        return 'failed';
    }
    foreach ($report['scenarios'] as $scenario) {
        if ('pass' !== ($scenario['status'] ?? null)) {
            return 'failed';
        }
    }

    return 'passed';
}

/**
 * @param array<string, mixed> $report
 */
function write(array $report): void
{
    echo json_encode($report, \JSON_PRETTY_PRINT | \JSON_UNESCAPED_SLASHES | \JSON_THROW_ON_ERROR)."\n";
}
