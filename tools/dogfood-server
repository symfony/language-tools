#!/usr/bin/env php
<?php

require __DIR__.'/../vendor/autoload.php';
require_once __DIR__.'/ContentLengthProcessClient.php';

use Symfony\Lsp\Tools\ContentLengthProcessClient;
use Symfony\Lsp\Tools\Dogfood\ProbeFinder;
use Symfony\Lsp\Tools\Dogfood\ProtocolValidator;
use Symfony\Lsp\Tools\Dogfood\ServerHarness;

function uri(string $path): string
{
    return 'file://'.str_replace('%2F', '/', rawurlencode($path));
}

function languageId(string $path): string
{
    return match (strtolower(pathinfo($path, \PATHINFO_EXTENSION))) {
        'js', 'mjs' => 'javascript',
        'php' => 'php',
        'ts' => 'typescript',
        'twig' => 'twig',
        'yaml', 'yml' => 'yaml',
        'json' => 'json',
        'xlf', 'xliff' => 'xml',
        default => 'plaintext',
    };
}

const USAGE = "Usage: dogfood-server [--environment=ENV] [--index-timeout=SECONDS] [--request-timeout=SECONDS] [--probe-roots=DIR,DIR] [--probes-per-category=COUNT] <server> <project>\n";

$environment = 'dev';
$indexTimeout = 30.0;
$requestTimeout = 10.0;
$probeRoots = ProbeFinder::DEFAULT_ROOTS;
$probesPerCategory = 1;
$positional = [];
foreach (array_slice($argv, 1) as $argument) {
    if (preg_match('/^--environment=(.+)$/', $argument, $matches)) {
        $environment = $matches[1];
    } elseif (preg_match('/^--index-timeout=(\d+)$/', $argument, $matches)) {
        $indexTimeout = (float) $matches[1];
    } elseif (preg_match('/^--request-timeout=(\d+)$/', $argument, $matches)) {
        $requestTimeout = (float) $matches[1];
    } elseif (preg_match('/^--probe-roots=(.+)$/', $argument, $matches)) {
        $probeRoots = array_values(array_filter(explode(',', $matches[1]), static fn (string $root): bool => '' !== $root));
    } elseif (preg_match('/^--probes-per-category=(\d+)$/', $argument, $matches)) {
        $probesPerCategory = max(1, (int) $matches[1]);
    } elseif (str_starts_with($argument, '-')) {
        fwrite(\STDERR, USAGE);
        exit(2);
    } else {
        $positional[] = $argument;
    }
}
if (2 !== count($positional)) {
    fwrite(\STDERR, USAGE);
    exit(2);
}
[$server, $project] = $positional;
$project = realpath($project);
if (false === $project) {
    throw new RuntimeException('Project does not exist.');
}

$totalStartedAt = hrtime(true);
$elapsedMilliseconds = static fn (int $startedAt): float => round((hrtime(true) - $startedAt) / 1_000_000, 1);
$startupStartedAt = hrtime(true);
$client = new ContentLengthProcessClient([$server], max(10.0, $requestTimeout), getenv());
$startupMilliseconds = $elapsedMilliseconds($startupStartedAt);
try {
    $id = 1;
    $initializeStartedAt = hrtime(true);
    $initialize = $client->request($id, 'initialize', [
        'processId' => null,
        'rootUri' => uri($project),
        'workspaceFolders' => [['uri' => uri($project), 'name' => basename($project)]],
        'capabilities' => new stdClass(),
        'initializationOptions' => ['workspaceTrust' => true, 'runtimeIndexing' => true, 'environment' => $environment],
    ], 10.0);
    $initializeMilliseconds = $elapsedMilliseconds($initializeStartedAt);
    $client->notify('initialized');

    $status = null;
    $terminal = false;
    $sourceIndexMilliseconds = null;
    $runtimeIndexMilliseconds = null;
    $indexStartedAt = hrtime(true);
    $deadline = microtime(true) + $indexTimeout;
    while (microtime(true) < $deadline) {
        $response = $client->request(++$id, 'workspace/executeCommand', ['command' => 'symfony.indexStatus'], $requestTimeout);
        $status = $response['result'][0] ?? null;
        if (is_array($status)) {
            if (null === $sourceIndexMilliseconds && in_array($status['source']['state'] ?? null, ['ready', 'failed'], true)) {
                $sourceIndexMilliseconds = $elapsedMilliseconds($indexStartedAt);
            }
            if (null === $runtimeIndexMilliseconds && in_array($status['runtime']['state'] ?? null, ['ready', 'failed', 'stale'], true)) {
                $runtimeIndexMilliseconds = $elapsedMilliseconds($indexStartedAt);
            }
            if (null !== $sourceIndexMilliseconds && null !== $runtimeIndexMilliseconds) {
                $terminal = true;
                break;
            }
        }
        usleep(250_000);
    }
    $indexWaitMilliseconds = $elapsedMilliseconds($indexStartedAt);
    $runtimeBridgeTimings = \is_array($status['runtime']['timings'] ?? null) ? $status['runtime']['timings'] : null;

    $probeDiscoveryStartedAt = hrtime(true);
    $probes = (new ProbeFinder($probeRoots, $probesPerCategory))->find($project);
    $probeDiscoveryMilliseconds = $elapsedMilliseconds($probeDiscoveryStartedAt);
    $validator = new ProtocolValidator();
    $opened = [];
    $results = [];
    $violations = [];
    $requestsStartedAt = hrtime(true);
    foreach ($probes as $probe) {
        $documentUri = uri($probe->path);
        if (!isset($opened[$documentUri])) {
            $client->notify('textDocument/didOpen', ['textDocument' => [
                'uri' => $documentUri,
                'languageId' => languageId($probe->path),
                'version' => 1,
                'text' => $probe->contents,
            ]]);
            $opened[$documentUri] = true;
        }
        $position = ['line' => $probe->line, 'character' => $probe->character];
        $entry = [
            'category' => $probe->category,
            'file' => substr($probe->path, strlen($project) + 1),
            'value' => $probe->value,
            'requests' => [],
        ];
        foreach (ServerHarness::PROBE_METHODS as $method) {
            $params = ['textDocument' => ['uri' => $documentUri]];
            if (!in_array($method, ['textDocument/documentLink', 'textDocument/codeLens', 'textDocument/codeAction'], true)) {
                $params['position'] = $position;
            }
            if ('textDocument/codeAction' === $method) {
                $params['range'] = ['start' => $position, 'end' => $position];
                $params['context'] = ['diagnostics' => []];
            }
            if ('textDocument/references' === $method) {
                $params['context'] = ['includeDeclaration' => true];
            } elseif ('textDocument/rename' === $method) {
                $params['newName'] = 'dogfood_'.str_replace(['.', '\\', '/'], '_', $probe->value);
            }
            $startedAt = microtime(true);
            $response = $client->request(++$id, $method, $params, $requestTimeout);
            $result = $response['result'] ?? null;
            foreach ($validator->validate($method, $result, $project) as $violation) {
                $violations[] = ['category' => $probe->category, 'method' => substr($method, strlen('textDocument/')), 'message' => $violation];
            }
            $entry['requests'][substr($method, strlen('textDocument/'))] = [
                'milliseconds' => round((microtime(true) - $startedAt) * 1000, 1),
                'resultCount' => is_array($result) && array_is_list($result) ? count($result) : (null === $result ? 0 : 1),
                'error' => $response['error']['message'] ?? null,
            ];
        }
        $results[] = $entry;
    }

    foreach (array_keys($opened) as $documentUri) {
        $client->notify('textDocument/didClose', ['textDocument' => ['uri' => $documentUri]]);
    }
    $requestsMilliseconds = $elapsedMilliseconds($requestsStartedAt);
    $shutdownStartedAt = hrtime(true);
    $client->request(++$id, 'shutdown', timeout: $requestTimeout);
    $client->notify('exit');
    $exitCode = $client->close(ServerHarness::PROCESS_EXIT_TIMEOUT);
    $shutdownMilliseconds = $elapsedMilliseconds($shutdownStartedAt);
    $stderr = $client->errorOutput();
    $diagnostics = [];
    foreach ($client->notifications() as $notification) {
        if ('textDocument/publishDiagnostics' === ($notification['method'] ?? null)) {
            $diagnostics[] = [
                'uri' => $notification['params']['uri'] ?? null,
                'items' => $notification['params']['diagnostics'] ?? [],
            ];
        }
    }

    $totalMilliseconds = $elapsedMilliseconds($totalStartedAt);
    echo json_encode([
        'project' => $project,
        'environment' => $environment,
        'serverVersion' => $initialize['result']['serverInfo']['version'] ?? null,
        'status' => $status,
        'terminal' => $terminal,
        'probeCount' => count($results),
        'probes' => $results,
        'violations' => $violations,
        'diagnostics' => $diagnostics,
        'serverError' => '' === trim($stderr) ? null : trim($stderr),
        'exitCode' => $exitCode,
        'runtimeBridgeTimings' => $runtimeBridgeTimings,
        'timings' => [
            'startupMilliseconds' => $startupMilliseconds,
            'initializeMilliseconds' => $initializeMilliseconds,
            'sourceIndexMilliseconds' => $sourceIndexMilliseconds,
            'runtimeIndexMilliseconds' => $runtimeIndexMilliseconds,
            'indexWaitMilliseconds' => $indexWaitMilliseconds,
            'probeDiscoveryMilliseconds' => $probeDiscoveryMilliseconds,
            'requestsMilliseconds' => $requestsMilliseconds,
            'shutdownMilliseconds' => $shutdownMilliseconds,
            'totalMilliseconds' => $totalMilliseconds,
        ],
    ], \JSON_PRETTY_PRINT | \JSON_UNESCAPED_SLASHES | \JSON_THROW_ON_ERROR)."\n";
} finally {
    $client->terminate();
}
