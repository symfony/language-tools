#!/usr/bin/env php
<?php

require __DIR__.'/../vendor/autoload.php';
require_once __DIR__.'/ContentLengthProcessClient.php';

use Symfony\Lsp\Tools\ContentLengthProcessClient;

function percentile(array $samples, float $percentile): float
{
    sort($samples);
    $index = (int) ceil($percentile * count($samples)) - 1;

    return $samples[max(0, $index)];
}

function rss(int $pid): ?int
{
    $output = [];
    exec('ps -o rss= -p '.escapeshellarg((string) $pid), $output, $status);
    if (0 !== $status || !isset($output[0]) || !is_numeric(trim($output[0]))) {
        return null;
    }

    return (int) trim($output[0]) * 1024;
}

if ($argc < 3 || $argc > 4) {
    fwrite(\STDERR, "Usage: benchmark-server <server> <project> [iterations]\n");
    exit(2);
}

$server = realpath($argv[1]);
$project = realpath($argv[2]);
$iterations = isset($argv[3]) ? (int) $argv[3] : 100;
if (false === $server || false === $project || $iterations < 1) {
    throw new InvalidArgumentException('The server, project, and iteration count must be valid.');
}

$client = new ContentLengthProcessClient([$server], 30.0);
try {
    $pid = $client->pid();
    $id = 1;
    $rootUri = 'file://'.str_replace('%2F', '/', rawurlencode($project));
    $startedAt = microtime(true);
    $initialize = $client->request($id, 'initialize', [
        'processId' => null,
        'rootUri' => $rootUri,
        'workspaceFolders' => [['uri' => $rootUri, 'name' => basename($project)]],
        'capabilities' => new stdClass(),
        'initializationOptions' => ['workspaceTrust' => true],
    ], 10.0);
    $initializedAt = microtime(true);
    $client->notify('initialized');

    $sourceReadyAt = null;
    $runtimeReadyAt = null;
    $indexStatus = null;
    $deadline = microtime(true) + 30.0;
    while (microtime(true) < $deadline) {
        $response = $client->request(++$id, 'workspace/executeCommand', ['command' => 'symfony.indexStatus']);
        $indexStatus = $response['result'][0] ?? null;
        if (is_array($indexStatus)) {
            $now = microtime(true);
            if (null === $sourceReadyAt && 'ready' === ($indexStatus['source']['state'] ?? null)) {
                $sourceReadyAt = $now;
            }
            if (null === $runtimeReadyAt && 'ready' === ($indexStatus['runtime']['state'] ?? null)) {
                $runtimeReadyAt = $now;
            }
            if (null !== $sourceReadyAt && null !== $runtimeReadyAt) {
                break;
            }
            if ('failed' === ($indexStatus['source']['state'] ?? null) || 'failed' === ($indexStatus['runtime']['state'] ?? null)) {
                break;
            }
        }
        usleep(25_000);
    }

    $documentUri = $rootUri.'/src/SymfonyLspBenchmark.php';
    $text = <<<'PHP'
        <?php
        final class SymfonyLspBenchmark extends AbstractController
        {
            public function run(): void
            {
                $this->generateUrl('fixture_home');
            }
        }
        PHP;
    $client->notify('textDocument/didOpen', ['textDocument' => [
        'uri' => $documentUri,
        'languageId' => 'php',
        'version' => 1,
        'text' => $text,
    ]]);
    $prefixOffset = strpos($text, 'fixture_home') + strlen('fixture_');
    $hoverOffset = strpos($text, 'fixture_home') + 2;
    $position = static function (int $offset) use ($text): array {
        $before = substr($text, 0, $offset);
        $line = substr_count($before, "\n");
        $lastNewline = strrpos($before, "\n");

        return ['line' => $line, 'character' => strlen(false === $lastNewline ? $before : substr($before, $lastNewline + 1))];
    };
    $completionParams = ['textDocument' => ['uri' => $documentUri], 'position' => $position($prefixOffset)];
    $hoverParams = ['textDocument' => ['uri' => $documentUri], 'position' => $position($hoverOffset)];
    $client->request(++$id, 'textDocument/completion', $completionParams);
    $client->request(++$id, 'textDocument/hover', $hoverParams);
    $memoryBefore = rss($pid);
    $completionSamples = [];
    $hoverSamples = [];
    for ($iteration = 0; $iteration < $iterations; ++$iteration) {
        $before = hrtime(true);
        $client->request(++$id, 'textDocument/completion', $completionParams);
        $completionSamples[] = (hrtime(true) - $before) / 1_000_000;
        $before = hrtime(true);
        $client->request(++$id, 'textDocument/hover', $hoverParams);
        $hoverSamples[] = (hrtime(true) - $before) / 1_000_000;
    }
    $memoryAfter = rss($pid);

    $cancellationId = ++$id;
    $cancellationStartedAt = hrtime(true);
    $client->write(['jsonrpc' => '2.0', 'id' => $cancellationId, 'method' => 'textDocument/completion', 'params' => $completionParams]);
    $client->notify('$/cancelRequest', ['id' => $cancellationId]);
    $cancellationResponse = $client->awaitResponse($cancellationId, 10.0);
    $cancellationMilliseconds = (hrtime(true) - $cancellationStartedAt) / 1_000_000;

    $client->notify('textDocument/didClose', ['textDocument' => ['uri' => $documentUri]]);
    $shutdown = $client->request(++$id, 'shutdown');
    $client->notify('exit');
    $exitCode = $client->close();
    $stderr = $client->errorOutput();

    $initializeSeconds = $initializedAt - $startedAt;
    $sourceSeconds = null === $sourceReadyAt ? null : $sourceReadyAt - $initializedAt;
    $runtimeSeconds = null === $runtimeReadyAt ? null : $runtimeReadyAt - $initializedAt;
    $completionP95 = percentile($completionSamples, 0.95);
    $hoverP95 = percentile($hoverSamples, 0.95);
    $cancellationObserved = -32800 === ($cancellationResponse['error']['code'] ?? null);
    $result = [
        'serverVersion' => $initialize['result']['serverInfo']['version'] ?? null,
        'iterations' => $iterations,
        'initializeMilliseconds' => round($initializeSeconds * 1000, 2),
        'sourceIndexMilliseconds' => null === $sourceSeconds ? null : round($sourceSeconds * 1000, 2),
        'runtimeIndexMilliseconds' => null === $runtimeSeconds ? null : round($runtimeSeconds * 1000, 2),
        'completionP95Milliseconds' => round($completionP95, 2),
        'hoverP95Milliseconds' => round($hoverP95, 2),
        'cancellationMilliseconds' => round($cancellationMilliseconds, 2),
        'cancellationObserved' => $cancellationObserved,
        'idleMemoryBytesBefore' => $memoryBefore,
        'idleMemoryBytesAfter' => $memoryAfter,
        'idleMemoryGrowthBytes' => null === $memoryBefore || null === $memoryAfter ? null : $memoryAfter - $memoryBefore,
        'indexStatus' => $indexStatus,
        'targets' => [
            'completionP95Under100Milliseconds' => $completionP95 < 100,
            'hoverP95Under100Milliseconds' => $hoverP95 < 100,
            'sourceIndexUnder500Milliseconds' => null !== $sourceSeconds && $sourceSeconds < 0.5,
            'runtimeIndexUnder3Seconds' => null !== $runtimeSeconds && $runtimeSeconds < 3,
            'cancellationObservedUnder100Milliseconds' => $cancellationObserved && $cancellationMilliseconds < 100,
            'idleMemoryGrowthUnder10MiB' => null === $memoryBefore || null === $memoryAfter || $memoryAfter - $memoryBefore < 10 * 1024 * 1024,
        ],
        'shutdownSucceeded' => array_key_exists('result', $shutdown),
        'exitCode' => $exitCode,
        'serverError' => '' === trim($stderr) ? null : trim($stderr),
    ];

    echo json_encode($result, \JSON_PRETTY_PRINT | \JSON_UNESCAPED_SLASHES | \JSON_THROW_ON_ERROR)."\n";
} finally {
    $client->terminate();
}
