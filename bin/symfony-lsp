#!/usr/bin/env php
<?php

use Symfony\Component\Filesystem\Path;
use Symfony\Lsp\Check\CheckCommand;
use Symfony\Lsp\Check\CheckOutputWriter;
use Symfony\Lsp\Server\LanguageServerFactory;
use Symfony\Lsp\Server\MemoryLimit;
use Symfony\Lsp\Server\SensitiveDataRedactor;
use Symfony\Lsp\Server\ServerLogger;
use Symfony\Lsp\Server\ServerVersion;

use Amp\ByteStream\ReadableResourceStream;
use Amp\ByteStream\WritableResourceStream;

use function Amp\ByteStream\getStderr;
use function Amp\ByteStream\getStdin;
use function Amp\ByteStream\getStdout;

$processStartedAt = hrtime(true);

// Keep PHP errors off stdout (the JSON-RPC channel); the micro SAPI ignores display_errors=stderr
ini_set('display_errors', '0');
ini_set('log_errors', '1');
ini_set('error_log', '');

require dirname(__DIR__).'/vendor/autoload.php';

$memoryLimit = new MemoryLimit();
$memoryLimitOverride = getenv('SYMFONY_LSP_MEMORY_LIMIT');
if (false !== $memoryLimitOverride && '' !== $memoryLimitOverride && !$memoryLimit->isValid($memoryLimitOverride)) {
    fwrite(\STDERR, sprintf('Ignoring the invalid SYMFONY_LSP_MEMORY_LIMIT value "%s"; use a PHP memory limit such as "512M", "4G" or "-1".%s', $memoryLimitOverride, \PHP_EOL));
}
if (null !== $newMemoryLimit = $memoryLimit->resolve((string) ini_get('memory_limit'), $memoryLimitOverride)) {
    ini_set('memory_limit', $newMemoryLimit);
}

if (in_array($argv[1] ?? null, ['--version', '-V'], true)) {
    fwrite(\STDOUT, 'Symfony Language Tools '.(new ServerVersion())->value()."\n");
    exit(0);
}
if (in_array($argv[1] ?? null, ['--help', '-h'], true)) {
    fwrite(\STDOUT, "Usage: symfony-lsp [--help] [--version] [--socket=<port>]\n       symfony-lsp check [options] [files, directories or patterns]\n");
    exit(0);
}

$command = $argv[1] ?? null;
if (null !== $command && 'check' !== $command && 1 !== preg_match('/^--socket=\d+$/D', $command)) {
    fwrite(\STDERR, \sprintf('Unknown command "%s".%s', $command, \PHP_EOL));
    exit(CheckCommand::EXIT_INVOCATION);
}

if (!function_exists('symfony_lsp_tree_sitter_parse')) {
    $extension = dirname(__DIR__).'/var/build/tree_sitter/modules/symfony_lsp_tree_sitter.so';
    if (is_file($extension) && function_exists('pcntl_exec')) {
        pcntl_exec(\PHP_BINARY, ['-d', 'extension='.$extension, __FILE__, ...array_slice($argv, 1)]);
    }
}

$errorOutput = getStderr();
$defaultPhpCommand = ['php'];
$symfonyCli = getenv('SYMFONY_LSP_SYMFONY_CLI');
if (false !== $symfonyCli && '' !== $symfonyCli && Path::isAbsolute($symfonyCli)) {
    $defaultPhpCommand = [$symfonyCli, 'php'];
}
$releaseMetadataUrl = getenv('SYMFONY_LSP_RELEASE_METADATA_URL');
if (false === $releaseMetadataUrl || '' === $releaseMetadataUrl) {
    $releaseMetadataUrl = 'https://symfony.com/releases.json';
}
$factory = new LanguageServerFactory(
    defaultPhpCommand: $defaultPhpCommand,
    releaseMetadataUrl: $releaseMetadataUrl,
);
if ('check' === $command) {
    $execution = $factory->createCheck($errorOutput)->run(array_values(array_slice($argv, 2)), $processStartedAt);
    $writer = new CheckOutputWriter();
    if (!$writer->write(\STDOUT, $execution->stdout)) {
        $writer->write(\STDERR, "Unable to write the diagnostics report to standard output.\n");
        exit(CheckCommand::EXIT_OPERATIONAL);
    }
    if ('' !== $execution->stderr) {
        $writer->write(\STDERR, $execution->stderr);
    }
    exit($execution->exitCode);
}

if (!function_exists('symfony_lsp_tree_sitter_parse')) {
    fwrite(\STDERR, "The Symfony Language Tools Tree-sitter parser is unavailable. Run: composer tree-sitter:build\n");
    exit(1);
}

$logger = new ServerLogger($errorOutput, new SensitiveDataRedactor());
try {
    $socketPort = null;
    foreach (array_slice($argv, 1) as $argument) {
        if (1 === preg_match('/^--socket=(\d+)$/', $argument, $match)) {
            $socketPort = (int) $match[1];
        }
    }

    if (null !== $socketPort) {
        $socket = @stream_socket_client('tcp://127.0.0.1:'.$socketPort, $errorCode, $errorMessage, 10);
        if (false === $socket) {
            fwrite(\STDERR, sprintf('Unable to connect to the client socket on port %d: %s%s', $socketPort, $errorMessage, \PHP_EOL));
            exit(1);
        }
        $input = new ReadableResourceStream($socket);
        $output = new WritableResourceStream($socket);
    } else {
        $input = getStdin();
        $output = getStdout();
    }
    $exitCode = $factory->create($input, $output, $errorOutput)->run();
} catch (\Throwable $error) {
    $logger->fatal($error);
    exit(1);
}

exit($exitCode);
