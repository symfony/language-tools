{
  "name": "symfony-lsp",
  "displayName": "Symfony LSP",
  "description": "Early access VS Code client for Symfony LSP",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/symfony/lsp.git"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onLanguage:php",
    "workspaceContains:composer.json"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "check": "tsc -p ./ --noEmit && tsc -p ./tsconfig.test.json --noEmit",
    "compile": "npm run check && esbuild src/extension.ts --bundle --platform=node --format=cjs --outfile=out/extension.js --external:vscode",
    "compile:production": "npm run check && esbuild src/extension.ts --bundle --platform=node --format=cjs --minify --outfile=out/extension.js --external:vscode",
    "compile-tests": "tsc -p ./tsconfig.test.json",
    "package": "npm run compile:production && vsce package",
    "test:e2e": "npm run compile && npm run compile-tests && node out/test/runTest.js"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/vscode": "^1.91.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  },
  "contributes": {
    "languages": [
      {
        "id": "twig",
        "aliases": [
          "Twig"
        ],
        "extensions": [
          ".twig",
          ".html.twig"
        ]
      }
    ],
    "configuration": {
      "title": "Symfony LSP",
      "properties": {
        "symfonyLsp.serverPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the Symfony LSP executable."
        },
        "symfonyLsp.phpCommand": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "php"
          ],
          "description": "Command and arguments used to run the project bridge."
        },
        "symfonyLsp.consolePath": {
          "type": "string",
          "default": "bin/console",
          "description": "Project console path used for cache maintenance."
        },
        "symfonyLsp.environment": {
          "type": "string",
          "default": "dev",
          "description": "Symfony environment used for runtime indexing."
        },
        "symfonyLsp.debug": {
          "type": "boolean",
          "default": true,
          "description": "Enable kernel debug mode during runtime indexing."
        },
        "symfonyLsp.runtimeIndexing": {
          "type": "boolean",
          "default": true,
          "description": "Enable trusted runtime indexing."
        },
        "symfonyLsp.projectRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Explicit application roots, relative to each workspace folder or absolute."
        },
        "symfonyLsp.trace": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Write redacted Language Server Protocol traffic to the Symfony LSP output channel."
        },
        "symfonyLsp.translationDiagnostics": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Report statically known translation keys missing from the effective catalogue."
        }
      }
    }
  }
}
